/* ~/.config/rofi/config.rasi */
configuration {
    modi: "drun,run,window,ssh";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "urxvt";
    drun-display-format: "{name}";
    window-format: "{w}  {c}  {t}";
    display-drun: "󰀻 ";
    display-run: " ";
    display-window: " ";
    display-ssh: "󰣀 ";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    disable-history: false;
    kb-cancel: "Escape,Control+g,Control+bracketleft";
}


@theme "~/.config/rofi/wal.rasi"